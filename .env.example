# Salin file ini menjadi .env lalu isi nilainya
# File .env TIDAK boleh di-commit ke GitHub

# Database
DB_PASSWORD=ganti_password_kuat_disini
MYSQL_ROOT_PASSWORD=ganti_root_password_disini

# Google Maps API Key (dari console.cloud.google.com)
GOOGLE_MAPS_API_KEY=

# Gemini API Key (dari aistudio.google.com/apikey - GRATIS, tanpa kartu)
# Ini penyedia AI UTAMA untuk itinerary planner.
GEMINI_API_KEY=

# Groq API Key (dari console.groq.com) - CADANGAN saja.
# Groq memblokir sebagian wilayah (server produksi di Azure East Asia dijawab
# 403 Forbidden), jadi hanya terpakai kalau GEMINI_API_KEY dikosongkan.
GROQ_API_KEY=
